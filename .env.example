# Variables para el perfil "production" del backend (MySQL - decisions/ADR-002-persistencia-sqlite.md).
# En desarrollo (perfil "development", por defecto) NO se necesita ninguna de estas variables:
# el backend usa SQLite en backend/data/parking.db automaticamente.
#
# Tambien las usa docker-compose.prod.yml (Fase 11 - Contenedorizacion): copiar este archivo a
# ".env" en la raiz del proyecto antes de "docker compose -f docker-compose.prod.yml up".

DB_HOST=localhost
DB_PORT=3306
DB_NAME=parking
DB_USER=parking_app
DB_PASSWORD=change-me
DB_USE_SSL=true
# Solo si DB_USE_SSL=false (MySQL 8): permitir que el driver pida la clave publica del servidor.
# Usar true unicamente en red privada (ej. el docker-compose.prod.yml de este repo).
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# Zona horaria y CORS (BR-026, decisions/ADR-004-autenticacion.md)
PARKING_TIMEZONE=America/Bogota
CORS_ALLOWED_ORIGINS=https://tu-dominio-de-produccion.example

# Primer administrador de una instalacion nueva (specs/decisions/ADR-007-arranque-produccion.md).
# Solo se usa si todavia no existe ningun administrador; despues se ignora. Contraseña de minimo
# 8 caracteres. RETIRAR PARKING_BOOTSTRAP_ADMIN_PASSWORD de este archivo tras el primer arranque y
# cambiar la contraseña desde la aplicacion.
PARKING_BOOTSTRAP_ADMIN_USERNAME=admin
PARKING_BOOTSTRAP_ADMIN_FULL_NAME=Jairo Francisco Seoanes Leon
PARKING_BOOTSTRAP_ADMIN_PASSWORD=admin123

# Cookies de sesion solo por HTTPS (revision OWASP A05). Poner true cuando la app se sirva con HTTPS.
SESSION_COOKIE_SECURE=false

# Perfil activo del backend: development | test | production
SPRING_PROFILES_ACTIVE=production
